# Open-FDD CRUD API — sites, points, equipment (AFDD stack; engine from PyPI open-fdd)
# BASE_IMAGE is overridable so cloud builds can pull the base from ACR instead of
# Docker Hub (which rate-limits anonymous pulls on ACR build agents). Local builds
# use the Docker Hub default; ACR builds pass
#   --build-arg BASE_IMAGE=3msecontainers.azurecr.io/python:3.14-slim
# after a one-time: az acr import -n 3mseContainers --source docker.io/library/python:3.14-slim --image python:3.14-slim
ARG BASE_IMAGE=python:3.14-slim
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md MANIFEST.in ./
COPY openfdd_stack ./openfdd_stack
RUN pip install --no-cache-dir "open-fdd>=2.1.0" \
 && pip install --no-cache-dir .
COPY pdf ./pdf

# Bake rules YAMLs into the image so OFDD_RULES_DIR=stack/rules resolves.
# NOTE: rules edited through the API are not persisted across restarts.
# Move to an Azure Files mount if rule edits need to survive revisions.
COPY stack/rules ./stack/rules

EXPOSE 8000
CMD ["uvicorn", "openfdd_stack.platform.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
